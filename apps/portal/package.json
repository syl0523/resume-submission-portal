{
  "name": "@jsp/portal",
  "version": "0.1.0",
  "private": true,
  "description": "The portal: one Cloudflare Worker serving the REST API, the React app, the inbound-email handler and the daily cron.",
  "type": "module",
  "scripts": {
    "predev": "node scripts/ensure-dev-vars.mjs && wrangler d1 migrations apply DB --local",
    "dev": "vite",
    "predev:remote": "node scripts/ensure-dev-vars.mjs && wrangler d1 migrations apply DB --local",
    "dev:remote": "vite --mode remote",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "wrangler d1 execute DB --local --file=./scripts/seed.sql"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "@dnd-kit/core": "6.3.1",
    "@hono/zod-validator": "0.9.1",
    "@jsp/core": "workspace:*",
    "@jsp/integrations": "workspace:*",
    "@tanstack/react-query": "5.105.3",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "jose": "6.2.15",
    "lucide-react": "1.67.0",
    "postal-mime": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/workers-types": "5.20261104.1",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "drizzle-kit": "0.31.11",
    "jsdom": "30.1.3",
    "miniflare": "5.20261103.0-beta",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "wrangler": "4.157.0"
  }
}
