{
  "name": "@jsp/extension",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome (MV3) extension: one-click job clipper for any posting page and review-before-submit autofill for Greenhouse, Lever and Ashby application forms.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@jsp/core": "workspace:*",
    "@jsp/integrations": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
