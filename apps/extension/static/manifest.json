{
  "manifest_version": 3,
  "name": "Resume Submission Portal",
  "version": "0.1.0",
  "description": "Save job postings to your Resume Portal in one click and fill company application forms for your review.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Resume Portal",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": ["activeTab", "scripting", "storage"],
  "short_name": "Resume Portal",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
